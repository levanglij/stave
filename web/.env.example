# Stave frontend — environment variables.
# Copy this file to `.env.local` for local dev; set the same keys in
# Vercel project settings for deploys. Never commit `.env.local` —
# the repo .gitignore excludes it.

# Privy app ID — get one from https://dashboard.privy.io
# Leave empty in dev to fall back to a mock connect flow.
NEXT_PUBLIC_PRIVY_APP_ID=

# Solana RPC endpoint. Devnet is the default for the hackathon.
# For production traffic, swap in a Helius / QuickNode URL.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Stave Anchor program ID on Solana devnet. Set after running:
#   anchor deploy --provider.cluster devnet
# from the program/ directory; copy the resulting program ID here.
NEXT_PUBLIC_PROGRAM_ID=
